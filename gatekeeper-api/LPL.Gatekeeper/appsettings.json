{
  "Logging": {
    "LogLevel": {
    "Default": "Information",
    "Microsoft.AspNetCore": "Warning",
    "LPL.Gatekeeper.Services.KafkaProducerService": "Debug",
    "LPL.Gatekeeper.Services.KafkaAuditConsumer": "Debug",
    "LPL.Gatekeeper.Services.RedisCacheService": "Debug"
  }
  },
  "AIEngine": {
    "BaseUrl": "http://localhost:8001"
  },
  "Jwt": {
    "Secret": "LPL-SuperSecret-Key-MinimumLength-32-Chars!!",
    "Issuer": "lpl-gatekeeper",
    "Audience": "lpl-advisors",
    "ExpiryHours": 8
  },
  "MongoDB": {
    "ConnectionString": "mongodb://admin:LPLMongo2024!@localhost:27017",
    "DatabaseName": "lpl_audit",
    "AuditCollection": "audit_events",
    "SessionCollection": "sessions"
  },
  "Kafka": {
    "BootstrapServers": "localhost:9092",
    "AuditTopic": "lpl.audit.events",
    "DeadLetterTopic": "lpl.audit.events.dlq",
    "ConsumerGroup": "lpl-audit-consumer",
    "EnableIdempotence": true
  },
  "Redis": {
  "ConnectionString": "localhost:6379,password=LPLRedis2024!",
  "SemanticCacheTtlMinutes": 60,
  "SimilarityThreshold": 0.92,
  "ExactCachePrefix": "exact:",
  "SemanticCachePrefix": "semantic:"
},
  "AllowedHosts": "*"
}